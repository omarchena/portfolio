---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getContent } from "../../i18n/content";

export const prerender = false;

const lang = Astro.params.lang === "en" ? "en" : Astro.params.lang === "es" ? "es" : null;
if (!lang) return Astro.redirect("/es/", 302);
const copy = getContent(lang);
const cvFile = lang === "es" ? "ES" : "EN";
---

<SiteLayout lang={lang} title={copy.title} description={copy.description} nav={copy.nav} language={copy.language}>
  <Fragment slot="footer">{copy.footer}</Fragment>
  <Fragment slot="rights">{copy.rights}</Fragment>

  <section class="hero section-wrap" id="inicio">
    <div class="hero-copy">
      <p class="eyebrow availability"><span class="status-dot"></span>{copy.availability}</p>
      <p class="mono hero-kicker">{copy.role}</p>
      <h1>Óscar Ricardo<br /><span>Marchena Chaves</span></h1>
      <p class="hero-description">{copy.hero}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#experiencia">{copy.actions[0]} <span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href="#contacto">{copy.actions[1]} <span aria-hidden="true">↗</span></a>
        <a class="social-link" href="https://www.linkedin.com/in/omarchena/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">in</a>
        <a class="social-link" href="mailto:oscar.marchena@hotmail.com" aria-label="Email">@</a>
      </div>
    </div>
    <aside class="hero-aside" aria-label="Profile">
      <div class="portrait-frame">
        <img src="/images/mi-foto.jpg" alt="Óscar Ricardo Marchena Chaves" />
        <span class="portrait-index mono">CR / 10° 25' N</span>
      </div>
      <div class="aside-caption"><span>GUANACASTE, COSTA RICA</span><span class="status-dot"></span><span>REMOTE · WORLDWIDE</span></div>
    </aside>
    <div class="metrics" aria-label="Career highlights">
      {copy.metrics.map(([value, label], index) => (
        <div class="metric">
          <span class="mono metric-index">0{index + 1}</span>
          <strong>{value}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about section-wrap section-pad" id="sobre-mi">
    <div class="section-heading">
      <p class="eyebrow mono">{copy.aboutEyebrow}</p>
      <h2>{copy.aboutTitle}</h2>
    </div>
    <div class="about-content">
      <div class="about-copy">
        {copy.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="principles">
        {copy.principles.map(([title, description], index) => (
          <article class="principle">
            <span class="mono principle-index">0{index + 1}</span>
            <div><h3>{title}</h3><p>{description}</p></div>
            <span class="principle-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="experience section-wrap section-pad" id="experiencia">
    <div class="section-heading section-heading-row">
      <div><p class="eyebrow mono">{copy.experienceEyebrow}</p><h2>{copy.experienceTitle}</h2></div>
      <p class="section-intro">{copy.experienceIntro}</p>
    </div>
    <div class="timeline">
      {copy.jobs.map((job, index) => (
        <article class="job">
          <div class="job-marker"><span></span></div>
          <div class="job-date mono">{job.date}</div>
          <div class="job-main">
            <div class="job-title"><h3>{job.title}</h3><span>{job.company}</span></div>
            <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            <div class="tag-list">{job.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
          {index === 0 && <span class="job-active mono">CURRENT</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="projects section-wrap section-pad" id="proyectos">
    <div class="section-heading section-heading-row">
      <div><p class="eyebrow mono">{copy.projectsEyebrow}</p><h2>{copy.projectsTitle}</h2></div>
      <p class="section-intro">{copy.projectsIntro}</p>
    </div>
    <div class="project-list">
      {copy.projects.map((project, index) => (
        <article class="project">
          <div class="project-copy">
            <p class="eyebrow mono"><span class="status-dot"></span>{project.label}</p>
            <span class="mono project-number">PROJECT / 0{index + 1}</span>
            <h3>{project.name}</h3>
            <p class="project-summary">{project.summary}</p>
            <div class="project-metrics">{project.metrics.map((metric) => <span>{metric}</span>)}</div>
            <div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel} <span aria-hidden="true">↗</span></a>
          </div>
          <a class="project-image" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={project.linkLabel}>
            <img src={project.image} alt={project.imageAlt} loading="lazy" />
            <span class="image-open" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
    <aside class="nda-note"><span class="mono">NDA /</span><div><h3>{copy.ndaTitle}</h3><p>{copy.nda}</p></div></aside>
  </section>

  <section class="certifications section-wrap section-pad" id="certificaciones">
    <div class="section-heading section-heading-row">
      <div>
        <div class="credential-heading-line">
          <p class="eyebrow mono">{copy.certificationsEyebrow}</p>
          <span class="credential-provider"><span class="status-dot"></span>{copy.certificationsProvider}</span>
        </div>
        <h2>{copy.certificationsTitle}</h2>
        <p class="section-intro">{copy.certificationsIntro}</p>
      </div>
      <a class="button button-secondary credential-profile" href="https://www.credly.com/users/oscar-marchena.a3eb5509/badges" target="_blank" rel="noopener noreferrer">
        {copy.verifyCredentials}<span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="credential-grid">
      {copy.certifications.map((credential, index) => (
        <article class:list={["credential", { "credential-featured": credential.featured }]}>
          <div class="credential-mark" aria-hidden="true">{credential.mark}</div>
          <div class="credential-content">
            <div class="credential-meta-top">
              <span class="mono credential-issuer">{credential.issuer}</span>
              {credential.featured && <span class="credential-status"><span class="status-dot"></span>VERIFIED</span>}
            </div>
            <h3>{credential.name}</h3>
            <p>{credential.description}</p>
            <div class="credential-footer">
              <span class="mono credential-type">{credential.type}</span>
              <time class="mono credential-date">{credential.date}</time>
            </div>
          </div>
          {credential.href && (
            <a class="credential-link" href={credential.href} target="_blank" rel="noopener noreferrer" aria-label={`${copy.verifyCredentials}: ${credential.name}`}>
              ↗
            </a>
          )}
          <span class="credential-index mono">0{index + 1}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="skills section-wrap section-pad" id="habilidades">
    <div class="section-heading centered">
      <p class="eyebrow mono">{copy.skillsEyebrow}</p><h2>{copy.skillsTitle}</h2><p class="section-intro">{copy.skillsIntro}</p>
    </div>
    <div class="skills-grid">
      {copy.skills.map(([title, description], index) => (
        <article class="skill">
          <span class="mono skill-index">0{index + 1} / SKILLSET</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact section-wrap section-pad" id="contacto">
    <div class="contact-intro">
      <p class="eyebrow mono">{copy.contactEyebrow}</p>
      <h2>{copy.contactTitle}</h2>
      <p class="contact-description">{copy.contactIntro}</p>
      <div class="contact-details">
        <a href="mailto:oscar.marchena@hotmail.com"><span class="mono">{copy.emailLabel}</span><strong>oscar.marchena@hotmail.com</strong></a>
        <a href="tel:+50689738816"><span class="mono">{copy.phoneLabel}</span><strong>+506 8973 8816</strong></a>
        <div><span class="mono">LOCATION</span><strong>{copy.location}</strong></div>
      </div>
      <a class="cv-link" href={`/assets/Curriculum%20vitae%20-%20Oscar%20Marchena%20Chaves_${cvFile}.pdf`} download>{copy.cv} <span aria-hidden="true">↓</span></a>
    </div>
    <div class="form-panel">
      <h3>{copy.formTitle}</h3>
      <p>{copy.formIntro}</p>
      <form id="contact-form" action="/api/contact" method="post" data-success={copy.sent} data-error={copy.formError} data-sending={copy.sending}>
        <div class="form-row">
          <label>{copy.fields[0]}<input name="name" autocomplete="name" placeholder={copy.placeholders[0]} required maxlength="100" /></label>
          <label>{copy.fields[1]}<input name="email" type="email" autocomplete="email" placeholder={copy.placeholders[1]} required maxlength="254" /></label>
        </div>
        <label>{copy.fields[2]}<input name="subject" placeholder={copy.placeholders[2]} required maxlength="150" /></label>
        <label>{copy.fields[3]}<textarea name="message" rows="4" placeholder={copy.placeholders[3]} required maxlength="5000"></textarea></label>
        <label class="honeypot" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label>
        <button class="button button-primary submit-button" type="submit">{copy.send}<span aria-hidden="true">↗</span></button>
        <p class="form-feedback" id="form-feedback" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const feedback = document.querySelector<HTMLElement>("#form-feedback");
  const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!feedback || !submit) return;
    submit.disabled = true;
    submit.textContent = form.dataset.sending ?? "Sending...";
    feedback.textContent = "";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!response.ok) throw new Error("Message delivery failed");
      feedback.textContent = form.dataset.success ?? "Message sent.";
      form.reset();
    } catch {
      feedback.textContent = form.dataset.error ?? "Please try again later.";
    } finally {
      submit.disabled = false;
      submit.textContent = form.querySelector("button")?.dataset.label ?? "Send message";
    }
  });

  if (submit && form) submit.dataset.label = submit.textContent?.trim() ?? "Send message";
</script>

<style>
  .section-wrap { width: min(var(--content), calc(100% - 48px)); margin-inline: auto; }
  .section-pad { padding-block: 108px; border-top: 1px solid #ffffff0d; }
  .hero { min-height: 660px; padding-top: 74px; padding-bottom: 46px; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(250px, .6fr); column-gap: 72px; align-items: center; }
  .hero-copy { padding-bottom: 42px; }
  .eyebrow, .mono { font-family: "DM Mono", monospace; }
  .eyebrow { color: var(--cyan); font-size: 11px; line-height: 1.7; letter-spacing: 0; text-transform: uppercase; }
  .availability { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 40px; padding: 8px 12px; border: 1px solid #a7e2c333; color: var(--mint); background: #a7e2c30b; }
  .status-dot { display: inline-block; flex: 0 0 auto; width: 7px; height: 7px; background: var(--mint); box-shadow: 0 0 0 4px #a7e2c31a; }
  .hero-kicker { margin: 0 0 14px; color: var(--blue); font-size: 12px; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, .job-title h3, .project h3 { font-family: Manrope, sans-serif; }
  h1 { max-width: 800px; margin-bottom: 20px; color: #f3f6f7; font-size: clamp(42px, 6vw, 72px); line-height: 1.05; font-weight: 800; }
  h1 span { color: var(--cyan); }
  .hero-description { max-width: 650px; margin-bottom: 28px; color: #a8b4bc; font-size: 18px; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 11px; }
  .social-link { display: grid; place-items: center; width: 42px; height: 42px; margin-left: 2px; border: 1px solid var(--line); color: #aab7bf; font: 500 14px "DM Mono", monospace; transition: color .2s, border-color .2s; }
  .social-link:hover { color: var(--cyan); border-color: var(--cyan); }
  .hero-aside { justify-self: end; width: min(100%, 310px); padding: 12px; border: 1px solid var(--line); background: #101820; transform: rotate(2deg); }
  .portrait-frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #1a2730; }
  .portrait-frame::after { position: absolute; inset: 50% 0 0; content: ""; background: linear-gradient(transparent, #071015b0); }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center 28%; filter: saturate(.78); }
  .portrait-index { position: absolute; z-index: 1; right: 12px; bottom: 12px; color: white; font-size: 10px; }
  .aside-caption { padding: 12px 2px 0; display: flex; align-items: center; gap: 7px; color: var(--muted); font: 9px "DM Mono", monospace; }
  .aside-caption .status-dot { width: 5px; height: 5px; }
  .metrics { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 22px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .metric { position: relative; min-height: 130px; padding: 22px 24px 20px 0; display: flex; flex-direction: column; justify-content: space-between; border-right: 1px solid var(--line); }
  .metric:not(:first-child) { padding-left: 24px; }
  .metric:last-child { border-right: 0; }
  .metric-index, .skill-index { color: #75838d; font-size: 10px; }
  .metric strong { color: #f0f4f5; font: 800 35px Manrope, sans-serif; }
  .metric:nth-child(2) strong { color: var(--mint); }
  .metric:nth-child(3) strong { color: var(--blue); }
  .metric > span:last-child { max-width: 180px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .section-heading { margin-bottom: 44px; }
  .section-heading .eyebrow { margin-bottom: 12px; }
  .section-heading h2, .contact h2 { max-width: 780px; margin-bottom: 0; color: #f1f4f5; font-size: clamp(30px, 4vw, 46px); line-height: 1.18; font-weight: 700; }
  .about-content { display: grid; grid-template-columns: 1fr 1fr; gap: 76px; align-items: start; }
  .about-copy { max-width: 580px; color: #a9b5bd; font-size: 15px; line-height: 1.85; }
  .about-copy p { margin-bottom: 17px; }
  .principles { border-top: 1px solid var(--line); }
  .principle { min-height: 91px; padding: 17px 0; display: grid; grid-template-columns: 38px 1fr 24px; gap: 12px; align-items: start; border-bottom: 1px solid var(--line); }
  .principle-index { padding-top: 4px; color: var(--cyan); font-size: 10px; }
  .principle h3 { margin: 0 0 5px; color: #eff3f4; font: 700 15px Manrope, sans-serif; }
  .principle p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
  .principle-arrow { color: #61717b; }
  .section-heading-row { display: flex; justify-content: space-between; align-items: end; gap: 32px; }
  .section-intro { max-width: 370px; margin: 0 0 4px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .timeline { border-top: 1px solid var(--line); }
  .job { position: relative; display: grid; grid-template-columns: minmax(150px, .42fr) 1fr auto; gap: 30px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .job-marker { position: absolute; top: 37px; left: -20px; width: 8px; height: 8px; border: 1px solid var(--cyan); background: var(--canvas); }
  .job-date { padding-top: 5px; color: var(--cyan); font-size: 11px; }
  .job-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 11px; }
  .job-title h3 { margin: 0; color: #edf2f4; font-size: 18px; font-weight: 700; }
  .job-title > span { color: var(--muted); font-size: 13px; }
  .job-main ul { margin: 0 0 16px; padding-left: 17px; color: #aab6bd; font-size: 13px; line-height: 1.8; }
  .job-main li { padding-left: 3px; }
  .job-main li::marker { color: var(--cyan); }
  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-list span { padding: 5px 8px; border: 1px solid #ffffff12; color: #aebac1; background: #ffffff04; font: 10px "DM Mono", monospace; }
  .job-active { align-self: start; padding: 5px 8px; color: var(--mint); background: #a7e2c310; font-size: 9px; }
  .project-list { display: grid; gap: 20px; }
  .project { display: grid; grid-template-columns: 1fr .88fr; min-height: 400px; border: 1px solid var(--line); background: #0d141a; }
  .project-copy { padding: clamp(24px, 4vw, 44px); display: flex; flex-direction: column; align-items: start; }
  .project-copy .eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
  .project-number { margin-bottom: 10px; color: #71808a; font-size: 10px; }
  .project h3 { margin: 0 0 12px; color: #f2f5f6; font-size: clamp(25px, 3vw, 34px); }
  .project-summary { max-width: 600px; margin-bottom: 20px; color: #aab6bd; font-size: 14px; line-height: 1.8; }
  .project-metrics { width: 100%; margin: auto 0 20px; padding: 14px 0; display: flex; flex-wrap: wrap; gap: 8px 22px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .project-metrics span { color: var(--mint); font: 11px "DM Mono", monospace; }
  .project .tag-list { margin-bottom: 24px; }
  .text-link, .cv-link { display: inline-flex; align-items: center; gap: 10px; color: var(--cyan); font-size: 13px; font-weight: 700; }
  .text-link:hover, .cv-link:hover { color: white; }
  .project-image { position: relative; min-height: 300px; overflow: hidden; background: #151f27; }
  .project-image::after { position: absolute; inset: 0; content: ""; background: linear-gradient(90deg, #0d141a22, transparent 35%); pointer-events: none; }
  .project-image img { width: 100%; height: 100%; min-height: 400px; display: block; object-fit: cover; transition: transform .5s ease; }
  .project-image:hover img { transform: scale(1.035); }
  .image-open { position: absolute; right: 16px; bottom: 16px; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; color: #071416; background: var(--cyan); }
  .nda-note { margin-top: 20px; padding: 24px 0; display: grid; grid-template-columns: 90px 1fr; gap: 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .nda-note > span { padding-top: 3px; color: var(--blue); font-size: 11px; }
  .nda-note h3 { margin: 0 0 6px; color: #e7ecef; font: 700 15px Manrope, sans-serif; }
  .nda-note p { max-width: 800px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .credential-heading-line { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .credential-heading-line .eyebrow { margin-bottom: 12px; }
  .credential-provider { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 12px; padding: 5px 9px; border: 1px solid #a7e2c329; color: var(--mint); background: #a7e2c309; font: 10px "DM Mono", monospace; }
  .credential-provider .status-dot { width: 6px; height: 6px; }
  .credential-profile { flex: 0 0 auto; }
  .credential-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .credential { position: relative; min-height: 238px; padding: 22px; display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 14px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #0d141a; }
  .credential-featured { grid-column: 1 / -1; min-height: 182px; grid-template-columns: 54px minmax(0, 1fr) auto; align-items: start; background: linear-gradient(100deg, #13201f 0%, #101820 58%, #101820 100%); }
  .credential-mark { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid #62d5dc58; border-radius: 50%; color: var(--cyan); background: #62d5dc10; font: 700 15px Manrope, sans-serif; }
  .credential-featured .credential-mark { width: 54px; height: 54px; border-color: #a7e2c36b; color: var(--mint); background: #a7e2c312; font-size: 19px; }
  .credential-content { min-width: 0; display: flex; flex-direction: column; }
  .credential-meta-top { min-height: 17px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .credential-issuer { color: var(--cyan); font-size: 9px; text-transform: uppercase; }
  .credential-status { display: inline-flex; align-items: center; gap: 7px; color: var(--mint); font: 9px "DM Mono", monospace; }
  .credential-status .status-dot { width: 5px; height: 5px; }
  .credential h3 { margin: 12px 0 8px; color: #eff3f4; font: 700 15px/1.45 Manrope, sans-serif; overflow-wrap: anywhere; }
  .credential p { margin: 0 0 16px; color: var(--muted); font-size: 12px; line-height: 1.65; }
  .credential-footer { margin-top: auto; padding-top: 12px; display: flex; justify-content: space-between; align-items: center; gap: 8px; border-top: 1px solid #ffffff12; }
  .credential-type, .credential-date { color: #82919b; font-size: 9px; }
  .credential-featured .credential-type { color: var(--mint); }
  .credential-link { grid-column: 2; justify-self: end; align-self: end; display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid #ffffff1b; color: var(--cyan); font-size: 15px; transition: color .2s, border-color .2s; }
  .credential-link:hover { border-color: var(--cyan); color: white; }
  .credential-index { position: absolute; top: 12px; right: 12px; color: #596771; font-size: 9px; }
  .credential-featured .credential-index { top: 18px; right: 18px; }
  .centered { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .centered .section-intro { max-width: 600px; margin-top: 12px; }
  .skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .skill { min-height: 180px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .skill-index { color: var(--cyan); }
